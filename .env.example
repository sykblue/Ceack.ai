# 서버에서만 사용합니다. VITE_ 접두사를 붙이지 마세요.
# 대화에 쓸 AI: ollama(내 컴퓨터, 무료) 또는 gemini(Google API 키 필요)
AI_PROVIDER=ollama
# Ollama 설정: ollama list에 보이는 모델 이름
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_HOST=http://127.0.0.1:11434
# Gemini 설정 (AI_PROVIDER=gemini일 때만 사용)
GEMINI_API_KEY=
# 계정에서 이용 가능한 Gemini 모델 ID
GEMINI_MODEL=gemini-3.8-flash
API_PORT=3001
